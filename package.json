{
  "name": "frontend-boilerplate-cli",
  "version": "1.0.0",
  "description": "A modern CLI to scaffold frontend projects with React, TypeScript, Vite and 7 production-ready architectures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-frontend-app": "dist/cli/cli.js",
    "frontend-boilerplate": "dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "react",
    "vite",
    "typescript",
    "boilerplate",
    "scaffold",
    "generator",
    "starter",
    "template",
    "architecture",
    "clean-architecture",
    "atomic-design",
    "micro-frontends",
    "frontend",
    "react-starter",
    "vite-template",
    "project-generator"
  ],
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "chalk": "^5.3.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kroquetitaa/frontend-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/Kroquetitaa/frontend-boilerplate/issues"
  },
  "homepage": "https://github.com/Kroquetitaa/frontend-boilerplate#readme",
  "author": {
    "name": "kroquetitaa",
    "email": "kroquetita@gmail.com",
    "url": "https://github.com/Kroquetitaa"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
